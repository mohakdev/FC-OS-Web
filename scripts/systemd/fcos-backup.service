# Encrypted DB backup -> private GitHub repo. User unit for the AIO box.
# Install: cp scripts/systemd/fcos-backup.{service,timer} ~/.config/systemd/user/
#          systemctl --user daemon-reload
#          systemctl --user enable --now fcos-backup.timer
#          loginctl enable-linger "$USER"   # so it runs without an active login
[Unit]
Description=FC OS encrypted DB backup to GitHub
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=%h/hosting/fc-os-web-local/scripts/backup-to-github.sh
# pg_dump/age/git live in the usual PATHs; keep it explicit for a clean systemd env.
Environment=PATH=/usr/local/bin:/usr/bin:/bin
Nice=10
# The user journal is not persisted on this box — `journalctl --user -u fcos-backup` came
# back empty while three nightly pushes were quietly failing. Keep our own log instead.
StandardOutput=append:%h/.local/state/fcos-backup.log
StandardError=append:%h/.local/state/fcos-backup.log
# (No Restart= here: systemd forbids it on Type=oneshot. The morning catch-up is
# fcos-backup-push.timer, which re-pushes without taking another dump.)
