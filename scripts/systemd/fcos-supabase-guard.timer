# Watchdog tick for fcos-supabase-guard.service. See the .service header for install steps.
# Slower than the funnel guard: nothing user-facing depends on these containers minute to
# minute, and the restart policy does most of the work once it is applied.
[Unit]
Description=FC OS Supabase stack watchdog

[Timer]
OnBootSec=3min
OnUnitActiveSec=10min
Persistent=true
RandomizedDelaySec=60

[Install]
WantedBy=timers.target
