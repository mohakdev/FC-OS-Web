# Nightly trigger for fcos-backup.service. See the .service header for install steps.
[Unit]
Description=Nightly FC OS DB backup

[Timer]
OnCalendar=*-*-* 03:00:00
# Fire a missed run after downtime (the box sees frequent power/WiFi loss).
Persistent=true
# Spread the load so it never lands exactly on the minute.
RandomizedDelaySec=300

[Install]
WantedBy=timers.target
